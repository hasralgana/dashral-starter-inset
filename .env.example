# Copy to .env.local for local development, or set these in your host's dashboard (e.g. Vercel).

# Public URL of the site, used for Open Graph and canonical URLs.
# Optional on Vercel production — falls back to productionUrl in lib/site.ts.
NEXT_PUBLIC_SITE_URL=

# The Dashral website: component docs, pricing. Defaults to https://dashral.com.
NEXT_PUBLIC_WEBSITE_URL=

# "false" removes every link to Dashral (the Pro card and Pro features in the menu, Docs, GitHub, All templates and the
# Free tag), so the app names only your brand. See lib/site.ts.
NEXT_PUBLIC_DASHRAL_LINKS=

